{
  "name": "wisp",
  "version": "0.1.0",
  "description": "Self-hosted, cookieless web analytics: a ~1KB tracker, a TypeScript collector, and a React dashboard on one Hono process backed by SQLite.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite",
    "start": "node --import tsx src/index.ts",
    "build": "tsc --noEmit",
    "build:tracker": "tsx scripts/build-tracker.ts",
    "build:web": "tsc -p web/tsconfig.json && vite build",
    "build:all": "npm run build:tracker && npm run build:web",
    "test": "npm run build:tracker && node --import tsx --test test/*.test.ts",
    "migrate": "tsx src/db/migrate.ts",
    "backup": "tsx scripts/backup.ts",
    "seed-site": "tsx scripts/seed-site.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.8.1",
    "hono": "^4.6.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.4.3"
  }
}
